# Required: an existing Foundry account and model deployment in public Azure.
AZURE_SUBSCRIPTION_ID = ""
AZURE_RESOURCE_GROUP = ""
AZURE_LOCATION = "eastus2"
FOUNDRY_ACCOUNT_NAME = ""
MODEL = ""

# Required: Feishu group custom bot with signature verification enabled.
FEISHU_WEBHOOK_URL = ""
FEISHU_WEBHOOK_KEY = ""

# Optional: distinct prefix per model/environment to avoid resource collisions.
RESOURCE_PREFIX = "foundry-alerts"
ACTION_GROUP_SHORT_NAME = "foundry429"

# Optional overrides; leave blank to derive names from RESOURCE_PREFIX.
LOGIC_APP_NAME = ""
INTEGRATION_ACCOUNT_NAME = ""
ACTION_GROUP_NAME = ""
ALERT_RULE_NAME = ""
DEPLOYMENT_NAME = ""

# Free is TEST ONLY, has no SLA, and is limited to one per region/subscription.
# Basic/Standard have fixed charges; review Azure pricing before changing.
INTEGRATION_ACCOUNT_SKU = "Free"

# Use the metric exposed by your Foundry deployment.
AZURE_METRIC_NAME = "AzureOpenAIRequests"
ALERT_WINDOW_MINUTES = "5"
ALERT_FREQUENCY_MINUTES = "1"
ALERT_THRESHOLD = "0"
ALERT_SEVERITY = "2"
DEPLOYMENT_TIMEOUT_SECONDS = "600"

# Optional model-test endpoint; blank derives it from FOUNDRY_ACCOUNT_NAME.
ENDPOINT = ""
SCOPE = "https://ai.azure.com/.default"